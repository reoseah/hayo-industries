{
  "multipart": [
    {
      "when": { "down": true, "up": true, "north": false, "south": false, "west": false, "east": false },
      "apply": { "model": "hayo:block/advanced_energy_conduit_straight" }
    },

    {
      "when": { "down": false, "up": false, "north": true, "south": true, "west": false, "east": false },
      "apply": { "model": "hayo:block/advanced_energy_conduit_straight", "x": 90 }
    },
    {
      "when": { "down": false, "up": false, "north": false, "south": false, "west": true, "east": true },
      "apply": { "model": "hayo:block/advanced_energy_conduit_straight", "x": 90, "y": 90 }
    },

    {
      "when": {
        "OR": [
          { "down": false, "up": false, "north": false, "south": false, "west": false, "east": false },

          { "down": true, "up": false },
          { "down": false, "up": true },
          { "north": true, "south": false },
          { "north": false, "south": true },
          { "west": true, "east": false },
          { "west": false, "east": true },

          { "down": true, "up": true, "north": true, "south": true },
          { "down": true, "up": true, "west": true, "east": true },
          { "north": true, "south": true, "west": true, "east": true }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_center" }
    },

    {
      "when": {
        "AND": [
          { "down": true },
          {
            "OR": [
              { "up": false },
              { "north": true },
              { "south": true },
              { "west": true },
              { "east": true }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection" }
    },
    {
      "when": {
        "AND": [
          { "up": true },
          {
            "OR": [
              { "down": false },
              { "north": true },
              { "south": true },
              { "west": true },
              { "east": true }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection", "uvlock": true, "x": 180 }
    },
    {
      "when": {
        "AND": [
          { "north": true },
          {
            "OR": [
              { "down": true },
              { "up": true },
              { "south": false },
              { "west": true },
              { "east": true }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection", "uvlock": true, "x": 90, "y": 180 }
    },
    {
      "when": {
        "AND": [
          { "south": true },
          {
            "OR": [
              { "down": true },
              { "up": true },
              { "north": false },
              { "west": true },
              { "east": true }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection", "uvlock": true, "x": 90 }
    },
    {
      "when": {
        "AND": [
          { "west": true },
          {
            "OR": [
              { "down": true },
              { "up": true },
              { "north": true },
              { "south": true },
              { "east": false }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection", "uvlock": true, "x": 90, "y": 90 }
    },
    {
      "when": {
        "AND": [
          { "east": true },
          {
            "OR": [
              { "down": true },
              { "up": true },
              { "north": true },
              { "south": true },
              { "west": false }
            ]
          }
        ]
      },
      "apply": { "model": "hayo:block/advanced_energy_conduit_connection", "uvlock": true, "x": 90, "y": 270 }
    }
  ]
}