{
  "multipart": [
    {
      "when": { "down": false, "up": false, "north": false, "south": false, "west": false, "east": false },
      "apply": { "model": "hayo:block/cable_unconnected" }
    },
    {
      "when": {
        "OR": [
          {
            "down": true
          },
          {
            "up": true
          },
          {
            "north": true
          },
          {
            "south": true
          },
          {
            "west": true
          },
          {
            "east": true
          }
        ]
      },
      "apply": { "model": "hayo:block/cable_center" }
    },
    {
      "when": { "down": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true }
    },
    {
      "when": { "up": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true, "x": 180 }
    },
    {
      "when": { "north": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true, "x": 90, "y": 180 }
    },
    {
      "when": { "south": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true, "x": 90 }
    },
    {
      "when": { "west": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true, "x": 90, "y": 90 }
    },
    {
      "when": { "east": true },
      "apply": { "model": "hayo:block/cable_connection", "uvlock": true, "x": 90, "y": 270 }
    }
  ]
}